# ==============================================================================
# CranialVIII / PaperEpley - Configuration Environment
# Fully Offline Clinical AI & Automated Fax/Record Engine
# ==============================================================================

# Database Settings (Local PostgreSQL 16 on 127.0.0.1)
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=dizzy
POSTGRES_USER=dizzy
POSTGRES_PASSWORD=change_this_to_generated_password
DATABASE_URL=postgresql://dizzy:change_this_to_generated_password@127.0.0.1:5432/dizzy

# Admin/Superuser (used only for initial migration / DB setup)
PGSUPERUSER=postgres
PGSUPERPASS=change_this_superuser_pass

# Storage & Ingest Mounts
# Windows: V:\ or \\clinic-nas\records
# macOS/Linux: /Volumes/Records or ./data/raw
SOURCE_ROOT=V:\
CRAWL_LIMIT=0

# Security & Key Encryption (HIPAA at-rest protection)
KEK_PATH=./keys/master.kek
KEK_ID=kek-2026-09
SESSION_SECRET=generate_random_session_secret_48_chars
SESSION_TTL_MINUTES=30

# Inbound Fax Integration - Microsoft Graph API (Cloud Ingest)
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
GRAPH_MAILBOXES=staff1@example.com,staff2@example.com

# PaperEpley Fax Slayer Daemon (Local Folders & Renamer)
PAPER_EPLEY_WATCH_DIR=V:\Faxes\Inbound
PAPER_EPLEY_PROCESSED_DIR=V:\Records\Filed
PAPER_EPLEY_CONFLICT_DIR=V:\Records\Human_Review_Queue
PAPER_EPLEY_POLL_INTERVAL_SEC=30

# Offline Sovereign Local AI (Ollama / llama.cpp on 127.0.0.1)
# Zero cloud leaks, zero per-token cost, 100% HIPAA sovereign
OFFLINE_AI_BASE_URL=http://127.0.0.1:11434/v1
OFFLINE_AI_API_KEY=ollama
OFFLINE_AI_MODEL=qwen2.5:14b-instruct-q4_K_M
OFFLINE_EMBED_MODEL=nomic-embed-text:latest

# Local Web Interface
WEB_HOST=127.0.0.1
WEB_PORT=8008
DEBUG=false
